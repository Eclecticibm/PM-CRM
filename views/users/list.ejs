<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { title: 'Users' }) %></head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <h1>Users</h1>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <table class="table">
      <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Active</th><th>Created</th><th></th></tr></thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr>
            <td><%= u.name %></td>
            <td><%= u.email %></td>
            <td><%= u.role %></td>
            <td><%= u.active ? 'Yes' : 'No' %></td>
            <td><%= u.created_at %></td>
            <td>
              <% if (u.active) { %>
                <form action="/users/<%= u.id %>/deactivate" method="POST" style="display:inline">
                  <button type="submit" class="btn btn-tiny">Deactivate</button>
                </form>
              <% } else { %>
                <form action="/users/<%= u.id %>/activate" method="POST" style="display:inline">
                  <button type="submit" class="btn btn-tiny">Activate</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <h2>Add User</h2>
    <form method="POST" action="/users" class="form">
      <label>Name<input type="text" name="name" required></label>
      <label>Email<input type="email" name="email" required></label>
      <label>Password<input type="password" name="password" required></label>
      <label>Role
        <select name="role">
          <option value="user">user</option>
          <option value="admin">admin</option>
        </select>
      </label>
      <button type="submit" class="btn btn-primary">Create User</button>
    </form>
  </main>
</body>
</html>
