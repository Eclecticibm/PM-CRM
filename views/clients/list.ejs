<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { title: 'Clients' }) %></head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <div class="page-header">
      <h1>Clients</h1>
      <div class="page-actions">
        <a href="/clients/new" class="btn btn-primary">+ New Client</a>
        <a href="/clients/export/csv" class="btn btn-secondary">Export CSV</a>
        <a href="/clients/import/csv" class="btn btn-secondary">Import CSV</a>
        <a href="/clients/archived/list" class="btn btn-secondary">Archived</a>
      </div>
    </div>

    <form method="GET" action="/clients" class="filter-bar">
      <input type="text" name="q" placeholder="Search name/company/email" value="<%= filters.q %>">
      <select name="status">
        <option value="">All Statuses</option>
        <% ['lead','active','inactive','churned'].forEach(function(s) { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
      <select name="tag">
        <option value="">All Tags</option>
        <% allTags.forEach(function(t) { %>
          <option value="<%= t %>" <%= filters.tag === t ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>
      <select name="owner">
        <option value="">All Owners</option>
        <% allUsers.forEach(function(u) { %>
          <option value="<%= u.id %>" <%= String(filters.owner) === String(u.id) ? 'selected' : '' %>><%= u.name %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-secondary">Filter</button>
      <a href="/clients" class="btn btn-link">Clear</a>
    </form>

    <table class="table">
      <thead>
        <tr><th>Name</th><th>Company</th><th>Status</th><th>Owner</th><th>Tags</th><th>Email</th><th>Phone</th></tr>
      </thead>
      <tbody>
        <% clients.forEach(function(c) { %>
          <tr>
            <td><a href="/clients/<%= c.id %>"><%= c.name %></a></td>
            <td><%= c.company || '' %></td>
            <td><span class="badge badge-<%= c.status %>"><%= c.status %></span></td>
            <td><%= c.owner_name || '' %></td>
            <td><%= c.tags || '' %></td>
            <td><%= c.email || '' %></td>
            <td><%= c.phone || '' %></td>
          </tr>
        <% }) %>
        <% if (clients.length === 0) { %>
          <tr><td colspan="7">No clients found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </main>
</body>
</html>
